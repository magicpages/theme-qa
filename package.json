{
  "name": "@magicpages/theme-qa",
  "version": "0.1.0",
  "description": "Shared quality checks for Ghost themes: GScan, a real Ghost in Docker with layered test content, and browser checks in Playwright.",
  "license": "MIT",
  "author": {
    "name": "Magic Pages",
    "email": "help@magicpages.co",
    "url": "https://www.magicpages.co"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magicpages/theme-qa.git"
  },
  "homepage": "https://github.com/magicpages/theme-qa#readme",
  "keywords": [
    "ghost",
    "ghost-theme",
    "qa",
    "playwright",
    "gscan"
  ],
  "type": "module",
  "bin": {
    "theme-qa": "./bin/theme-qa.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./test": "./tests/fixtures.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "fixtures/",
    "tests/"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "node --test",
    "lint": "editorconfig-checker && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "gscan": "^6.6.1",
    "lighthouse": "^13.6.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "semver": "^7.8.5",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "editorconfig-checker": "^6.2.0",
    "prettier": "^3.9.10"
  }
}
